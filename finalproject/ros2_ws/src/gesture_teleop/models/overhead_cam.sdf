<?xml version="1.0"?>
<!-- TB3 월드를 위에서 내려다보는 고정 카메라 -> /overhead_cam/image_raw -->
<sdf version="1.6">
  <model name="overhead_cam">
    <static>true</static>
    <pose>0 0 6 0 1.5708 0</pose>
    <link name="link">
      <sensor name="cam" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>20</far></clip>
        </camera>
        <plugin name="overhead_cam" filename="libgazebo_ros_camera.so">
          <ros><namespace>/overhead_cam</namespace><remapping>~/image_raw:=image_raw</remapping></ros>
          <camera_name>overhead_cam</camera_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
